    {
      "parameters": {
        "jsCode": "// Get the HTTP response from HTTP Request2\nconst httpResponse = $input.first().json;\n\n// Get the conversation context from Loop Over Items2\nconst loopItem = $('Loop Over Items2').first();\n\n// Merge the conversation context with the HTTP response\nreturn [{\n  json: {\n    ...httpResponse,\n    conversationId: loopItem.json.conversationId,\n    folder_id: loopItem.json.folder_id\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        660
      ],
      "id": "5655db90-38ae-4ecd-b9b0-3947680e20a4",
      "name": "Merge Context"
    },
    {
      "parameters": {
        "jsCode": "// Check if we have email data\nif (!$input.first().json.emailMessage) {\n  return [{\n    json: {\n      formatted: '[No email message found]\\n',\n      conversationId: 'unknown',\n      folder_id: 'unknown',\n      fileId: $('Create Empty File').first().json.id\n    }\n  }];\n}\n\nconst emailData = $input.first().json.emailMessage;\n\nconst timestamp = new Date(emailData.dateAdded || Date.now()).toISOString();\nconst sender = \"User\";\nconst subject = (emailData.subject || \"[No Subject]\").trim();\n\nlet body = emailData.body || \"[No Body]\";\n\n// Step 1: Strip all HTML tags\nbody = body.replace(/<\\/?[^>]+(>|$)/g, '');\n\n// Step 2: Decode basic HTML entities\nbody = body.replace(/&nbsp;/g, ' ')\n           .replace(/&amp;/g, '&')\n           .replace(/&lt;/g, '<')\n           .replace(/&gt;/g, '>');\n\n// Step 3: Remove large chunks of repeating unicode spaces or junk sequences\nbody = body.replace(/[\\u200B-\\u200D\\uFEFF]+/g, ''); // Zero-width spaces\nbody = body.replace(/(‌|‍|﻿|\\u00A0|\\u202F)+/g, ' '); // Non-breaking spaces, invisible chars\n\n// Step 4: Remove long sequences of random whitespace or line breaks\nbody = body.replace(/\\s{3,}/g, ' ');     // More than 2 spaces => 1 space\nbody = body.replace(/\\n{2,}/g, '\\n');    // Multiple newlines => single newline\nbody = body.replace(/[ \\t]+\\n/g, '\\n');  // Strip spaces before line breaks\nbody = body.replace(/\\n[ \\t]+/g, '\\n');  // Strip spaces after line breaks\nbody = body.trim();\n\n// Optional: Strip footer content if desired (e.g., unsubscribe, address, copyright)\nbody = body.split(\"Want to change how you receive these emails?\")[0];\nbody = body.split(\"Copyright ©\")[0];\nbody = body.split(\"Talk in French30\")[0];\n\n// Get conversation context from the input - this should come from HTTP Request2\nconst conversationId = $input.first().json.conversationId || 'unknown';\nconst folder_id = $input.first().json.folder_id || 'unknown';\n\nreturn [{\n  json: {\n    formatted: `[${sender}] - ${timestamp}:\\nSubject: ${subject}\\n${body}\\n\\n`,\n    conversationId: conversationId,\n    folder_id: folder_id,\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        760,
        660
      ],
      "id": "286c5a4a-8efa-49ab-8003-965293593ea5",
      "name": "Code6"
