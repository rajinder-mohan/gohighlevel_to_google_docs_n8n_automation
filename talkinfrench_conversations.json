    {
      "parameters": {
        "jsCode": "const formatted_message = $input.all();\n\n// Try to get folder_id from Loop Over Items1, fallback to If2\nlet studentFolderId = null;\n\ntry {\n  studentFolderId = $('Loop Over Items1').first()?.json?.folder_id;\n} catch (e) {\n  studentFolderId = null;\n}\n\nif (!studentFolderId) {\n  try {\n    studentFolderId = $('If2').first()?.json?.folder_id;\n  } catch (e) {\n    studentFolderId = null;\n  }\n}\nif (!studentFolderId) {\n  try {\n    studentFolderId = $input.first().json.folder_id;\n  } catch (e) {\n    studentFolderId = null;\n  }\n}\nlet fullText = '';\nfor (const m of formatted_message) {\n  fullText += m.json.formatted + '\\n';\n}\n\nreturn [{\n  json: {\n    studentFolderId,\n    fullText\n  }\n}];\n"
      },
