        "jsCode": "// const date_added = $input.first().json.dateAdded;\n// const direction = $input.first().json.direction\n// const timestamp = new Date(date_added).toISOString();\n// const sender = direction === \"inbound\" ? \"Contact\" : \"User\";\n// const msg = $input.first().json.body;\n// const body = msg || \"[no message]\";\n\n// return [{\n//   json: {\n//     formatted: `[${sender}] - ${timestamp}:\\n${body}\\n`\n//   }\n// }];\nconst items = $input.all();\n\nif (!items.length) {\n  throw new Error(\"No input items received\");\n}\n\n// Get folder ID from first input (assumed to be shared across all)\n\n// Collect all formatted messages\nconst messages = [];\n\n\n  for (const m of items) {\n    const timestamp = new Date(m.json.dateAdded).toISOString();\n    const sender = m.json.direction === \"inbound\" ? \"Contact\" : \"User\";\n    const body = m.json.body || \"[no message]\";\n    const folder_id  = m.json.folder_id;\n\n    messages.push({\n      formatted: `[${sender}] - ${timestamp}:\\n${body}\\n`,\n      folder_id:folder_id\n    });\n  }\n\nreturn messages\n"
      },
