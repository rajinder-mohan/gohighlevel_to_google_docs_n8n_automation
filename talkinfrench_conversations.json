    {
      "parameters": {
        "jsCode": "const mergeData = $('Merge1').all();     // contains id (conversationId) and folder_id\nconst inputItems = $input.all();         // contains messages[].conversationId\n\n/** @type {{ [key: string]: string }} */\nconst folderIdMap = {};  // typed map\n\n// Build the folderId mapping using conversationId\nfor (const item of mergeData) {\n  const conversationId = item.json.id;\n  const folderId = item.json.folder_id;\n\n  if (conversationId) {\n    folderIdMap[conversationId] = folderId;\n  }\n}\n\n// Map folder_id to each item + each message in messages array\nconst output = inputItems.map(item => {\n  const messagesArray = item.json.messages?.messages || [];\n  const conversationId = messagesArray[0]?.conversationId;\n  const folderId = folderIdMap[conversationId] || null;\n\n  // Add folder_id to each message object\n  const updatedMessages = messagesArray.map(msg => ({\n    ...msg,\n    folder_id: folderId,\n  }));\n\n  return {\n    json: {\n      ...item.json,\n      folder_id: folderId,                     // Top-level fallback\n      messages: {\n        ...item.json.messages,\n        messages: updatedMessages              // Updated messages array\n      }\n    }\n  };\n});\n\nreturn output;\n"
      },
