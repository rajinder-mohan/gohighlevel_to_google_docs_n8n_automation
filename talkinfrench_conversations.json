    {
      "parameters": {
        "jsCode": "var message_ids = []\nvar file_id = $input.first().json.id;\nfor (const m of $('No Operation, do nothing').all()) {\n  // Ensure we're processing TYPE_EMAIL messages only\n  \n    \n    const folder_id = m.json.folder_id;\n    for (const n of m.json.messages.messages) {\n      if (n.messageType == \"TYPE_EMAIL\") {\n        for (const messageId of n.meta.email.messageIds) {\n        message_ids.push({\n          json: {\n            messageId: messageId,\n            conversationId: n.conversationId,\n            folder_id: folder_id,\n            file_id:file_id\n          }\n        });\n      }\n      }\n      \n    }\n}\n\nreturn message_ids;"
